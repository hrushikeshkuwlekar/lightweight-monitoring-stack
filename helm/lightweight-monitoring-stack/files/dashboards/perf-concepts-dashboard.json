            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Users needed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f5b84b"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max users allowed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f25f6b"
                }
              }
            ]
          },
          {
            "matcher": {
