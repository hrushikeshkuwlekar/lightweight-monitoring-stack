    {
      "id": 9,
      "type": "row",
      "title": "Little's Law — users, TPS and response time are locked together",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "TPS: actual vs target vs predicted",
      "description": "Predicted (Fixed Users) = users ÷ (response time + think time). When actual tracks predicted, Little's Law holds. In Fixed Rate, actual should match target; if it falls short, check the diagnosis.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(loadgen_achieved_rps)",
          "legendFormat": "Actual TPS",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(loadgen_target_rps) > 0",
          "legendFormat": "Target TPS",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(loadgen_predicted_max_tps) and on() sum(loadgen_mode{mode=\"fixed_users\"}) == 1",
          "legendFormat": "Predicted TPS (users ÷ time per loop)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Actual TPS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4fb3ff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target TPS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7c8cff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target TPS"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Predicted TPS (users ÷ time per loop)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3ecf8e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Predicted TPS (users ÷ time per loop)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "In flight = TPS × response time",
      "description": "Little's Law check. The two lines should overlap: requests in flight equals throughput times response time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(loadgen_requests_in_flight)",
          "legendFormat": "In flight (measured)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
