                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TPS × response time"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3ecf8e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
