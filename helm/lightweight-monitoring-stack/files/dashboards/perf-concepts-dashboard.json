{
  "uid": "perf-concepts",
  "title": "Performance Concepts",
  "tags": [
    "load-testing",
    "tps",
    "littles-law"
  ],
  "description": "Little's Law, Fixed Users vs Fixed Rate, and finding the bottleneck: app or load generator.",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is the test healthy?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Diagnosis over time",
      "description": "The load generator's own verdict, every second. Healthy = keeping up. Not enough users = max users too low for target TPS × response time. App saturated = response time rising because requests queue in the app. Generator overloaded = the test tool itself is out of CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "0 * sum(loadgen_diagnosis{state=\"idle\"}) + 1 * sum(loadgen_diagnosis{state=\"warming_up\"}) + 2 * sum(loadgen_diagnosis{state=\"healthy\"}) + 3 * sum(loadgen_diagnosis{state=\"not_enough_users\"}) + 4 * sum(loadgen_diagnosis{state=\"app_saturated\"}) + 5 * sum(loadgen_diagnosis{state=\"generator_overloaded\"}) + 6 * sum(loadgen_diagnosis{state=\"failing\"})",
          "legendFormat": "Diagnosis",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#6e7a91"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Idle",
                  "color": "#6e7a91",
                  "index": 0
                },
                "1": {
                  "text": "Warming up",
                  "color": "#4fb3ff",
                  "index": 1
                },
                "2": {
                  "text": "Healthy",
                  "color": "#3ecf8e",
                  "index": 2
                },
                "3": {
                  "text": "Not enough users",
                  "color": "#f5b84b",
                  "index": 3
                },
                "4": {
                  "text": "App saturated",
                  "color": "#f25f6b",
                  "index": 4
                },
                "5": {
                  "text": "Generator overloaded",
                  "color": "#b48cff",
                  "index": 5
                },
                "6": {
                  "text": "Requests failing",
                  "color": "#c4162a",
                  "index": 6
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Actual TPS",
      "description": "Transactions per second completed (load generator, 5 s average).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(loadgen_achieved_rps)",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
