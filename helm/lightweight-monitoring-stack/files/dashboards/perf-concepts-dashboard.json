    {
      "id": 7,
      "type": "stat",
      "title": "Generator CPU",
      "description": "Load generator CPU as a share of its limit. Above 90% its numbers can't be trusted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 6
