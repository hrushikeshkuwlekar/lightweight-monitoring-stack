    {
      "id": 13,
      "type": "row",
      "title": "Where is the bottleneck?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Response time: client vs server",
      "description": "Client = measured by the load generator. Server = measured inside the app. Queue wait = time spent waiting for a worker slot. Client ≫ server means the delay is in the generator or network, not the app.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(loadgen_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "Client p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{endpoint=~\"/api/.*\"}[1m])) by (le))",
          "legendFormat": "Server p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(app_queue_wait_seconds_bucket[1m])) by (le))",
          "legendFormat": "App queue wait p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Client p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4fb3ff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Server p95"
            },
            "properties": [
              {
