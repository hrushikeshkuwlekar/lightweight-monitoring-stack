    {
      "id": 12,
      "type": "timeseries",
      "title": "Fixed Rate: users needed vs allowed",
      "description": "Users needed = target TPS × response time. If it rises above max users, the generator can't keep up and skips requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(loadgen_required_users) and on() sum(loadgen_mode{mode=\"fixed_rate\"}) == 1",
          "legendFormat": "Users needed",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(loadgen_max_users) > 0",
          "legendFormat": "Max users allowed",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loadgen_skipped_requests_total[1m]))",
          "legendFormat": "Skipped requests / s",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
