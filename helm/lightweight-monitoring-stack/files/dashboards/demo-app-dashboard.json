          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 150,
          "unit": "decmbytes",
          "thresholds": {
            "mode": "absolute",
