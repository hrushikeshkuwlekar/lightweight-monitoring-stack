    {
      "id": 7,
      "title": "Actual TPS vs Target TPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum(rate(loadgen_requests_total[15s]))",
          "legendFormat": "Achieved TPS",
          "refId": "A"
        },
        {
          "expr": "loadgen_target_rps",
          "legendFormat": "Target TPS",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Target RPS"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    4,
                    4
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Target Delivery Rate (%)",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "expr": "clamp_max(clamp_min((sum(rate(loadgen_requests_total[30s])) / clamp_min(sum(loadgen_target_rps), 0.01)) * 100, 0), 150) and on() sum(loadgen_target_rps) > 0",
          "legendFormat": "Delivery %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 150,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              },
              {
                "color": "yellow",
                "value": 115
              }
            ]
          }
        }
      }
    },
